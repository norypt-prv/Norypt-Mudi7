#!/bin/sh
# norypt-ghost rpcd exec backend — called by LuCI2 via fs.exec().
# Subcommands: status, new_identity, rotate, rotate_wireless,
#              sim_swap, imsi, set:<key>=<val>, log

. /lib/norypt-ghost/functions.sh

_js() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

case "$1" in
    status)
        _imei1=$(READ_IMEI 2>/dev/null | head -1)
        _imei2=$(READ_IMEI_SLOT2 2>/dev/null | head -1)
        _ssid=$(uci -q get wireless.wifi2g.ssid 2>/dev/null)
        _gssid=$(uci -q get wireless.guest2g.ssid 2>/dev/null)
        _mac2g=$(uci -q get wireless.wifi2g.macaddr 2>/dev/null)
        _mac5g=$(uci -q get wireless.wifi5g.macaddr 2>/dev/null)
        _macsta=$(uci -q get wireless.sta.macaddr 2>/dev/null)
        _mac6g=$(uci -q get wireless.wifi6g.macaddr 2>/dev/null)
        _macguest2g=$(uci -q get wireless.guest2g.macaddr 2>/dev/null)
        _macguest5g=$(uci -q get wireless.guest5g.macaddr 2>/dev/null)
        _macguest6g=$(uci -q get wireless.guest6g.macaddr 2>/dev/null)
        _host=$(uci -q get system.@system[0].hostname 2>/dev/null)
        _key=$(uci -q get wireless.wifi2g.key 2>/dev/null)
        _gkey=$(uci -q get wireless.guest2g.key 2>/dev/null)
        _opt_mac=$(uci -q get norypt-ghost.options.randomize_mac 2>/dev/null)
        _opt_ssid=$(uci -q get norypt-ghost.options.randomize_ssid 2>/dev/null)
        _opt_host=$(uci -q get norypt-ghost.options.randomize_hostname 2>/dev/null)
        _opt_pass=$(uci -q get norypt-ghost.options.randomize_password 2>/dev/null)
        _opt_boot=$(uci -q get norypt-ghost.options.randomize_on_boot 2>/dev/null)
        _opt_mode1=$(uci -q get norypt-ghost.options.imei_mode_slot1 2>/dev/null)
        _opt_mode2=$(uci -q get norypt-ghost.options.imei_mode_slot2 2>/dev/null)
        _sst1=$(uci -q get norypt-ghost.options.static_imei_slot1 2>/dev/null)
        _sst2=$(uci -q get norypt-ghost.options.static_imei_slot2 2>/dev/null)
        _reg_timeout=$(uci -q get norypt-ghost.options.register_timeout 2>/dev/null)
        _opt_rat_lock=$(uci -q get norypt-ghost.options.rat_lock 2>/dev/null)
        _opt_default_region=$(uci -q get norypt-ghost.options.default_region 2>/dev/null)
        _last_imei_rotate=$(cat /etc/norypt-ghost.last_imei_rotate 2>/dev/null)
        _last_wireless_rotate=$(cat /etc/norypt-ghost.last_wireless_rotate 2>/dev/null)
        _touch_enabled=$([ -n "$(ls /etc/rc.d/S*norypt-ghost-touch 2>/dev/null)" ] && printf '1' || printf '0')
        printf '{"imei1":"%s","imei2":"%s","ssid":"%s","guest_ssid":"%s","mac_2g":"%s","mac_5g":"%s","mac_6g":"%s","mac_sta":"%s","mac_guest2g":"%s","mac_guest5g":"%s","mac_guest6g":"%s","hostname":"%s","wifi2g_key":"%s","guest2g_key":"%s","opt_mac":"%s","opt_ssid":"%s","opt_hostname":"%s","opt_password":"%s","opt_boot":"%s","imei_mode_slot1":"%s","imei_mode_slot2":"%s","static_imei_slot1":"%s","static_imei_slot2":"%s","register_timeout":"%s","rat_lock":"%s","default_region":"%s","last_imei_rotate":"%s","last_wireless_rotate":"%s","touch_enabled":"%s"}\n' \
            "${_imei1:----}" "${_imei2:----}" \
            "$(_js "${_ssid:----}")" "$(_js "${_gssid:----}")" \
            "${_mac2g:----}" "${_mac5g:----}" "${_mac6g:----}" "${_macsta:----}" \
            "${_macguest2g:----}" "${_macguest5g:----}" "${_macguest6g:----}" \
            "$(_js "${_host:----}")" \
            "$(_js "${_key:----}")" "$(_js "${_gkey:----}")" \
            "${_opt_mac:-1}" "${_opt_ssid:-1}" "${_opt_host:-1}" "${_opt_pass:-1}" \
            "${_opt_boot:-1}" \
            "${_opt_mode1:-random}" "${_opt_mode2:-random}" \
            "$(_js "${_sst1}")" "$(_js "${_sst2}")" \
            "${_reg_timeout:-120}" \
            "${_opt_rat_lock:-1}" "${_opt_default_region:-NA}" \
            "$(_js "${_last_imei_rotate}")" \
            "$(_js "${_last_wireless_rotate}")" \
            "$_touch_enabled"
        ;;
    new_identity)
        # Full rotation (IMEIs + wireless/system + RAT/region) — the CLI
        # reboots the device at the end, so background and return at once.
        : > /tmp/norypt-ghost.log
        /usr/bin/norypt-ghost new-identity >> /tmp/norypt-ghost.log 2>&1 &
        printf '{"started":true}\n'
        ;;
    rotate)
        : > /tmp/norypt-ghost.log
        /usr/bin/norypt-ghost rotate >> /tmp/norypt-ghost.log 2>&1 &
        printf '{"started":true}\n'
        ;;
    rotate_wireless)
        : > /tmp/norypt-ghost.log
        /usr/bin/norypt-ghost rotate-wireless >> /tmp/norypt-ghost.log 2>&1 &
        printf '{"started":true}\n'
        ;;
    sim_swap)
        : > /tmp/norypt-ghost.log
        /usr/bin/norypt-ghost sim-swap >> /tmp/norypt-ghost.log 2>&1 &
        printf '{"started":true}\n'
        ;;
    imsi)
        # Async slow lane: IMSI plus live network state (registration,
        # operator, signal) — the page renders fast and fills these in late.
        _slot_imsi() {
            local _raw _imsi _cpin
            _raw=$(gl_modem -B CPU -U "$1" AT AT+CIMI 2>/dev/null | tr -d '\r')
            _imsi=$(printf '%s' "$_raw" | grep -E '^[0-9]{6,15}$' | head -1)
            if [ -n "$_imsi" ]; then
                printf '%s' "$_imsi"; return
            fi
            _cpin=$(gl_modem -B CPU -U "$1" AT 'AT+CPIN?' 2>/dev/null \
                    | tr -d '\r' | grep -E '^\+CPIN:' | head -1)
            [ -n "$_cpin" ] && printf '__failed__'
        }
        _imsi1=$(_slot_imsi 1)
        _imsi2=$(_slot_imsi 2)
        _net1=$(_decode_reg_stat "$(_read_reg_stat 1)")
        _net2=$(_decode_reg_stat "$(_read_reg_stat 2)")
        _operator=$(READ_OPERATOR)
        _signal=$(READ_SIGNAL)
        printf '{"slot1":"%s","slot2":"%s","reg1":"%s","reg2":"%s","operator":"%s","signal":"%s"}\n' \
            "$_imsi1" "$_imsi2" "$_net1" "$_net2" "$(_js "$_operator")" "$_signal"
        ;;
    set:*)
        _kv="${1#set:}"
        _key="${_kv%%=*}"
        _val="${_kv#*=}"
        # Validate per key — the LuCI client validates too, but anything with
        # rpcd exec access can call this directly, so never trust the value.
        case "$_key" in
            randomize_mac|randomize_ssid|randomize_hostname|randomize_password|randomize_on_boot|touch_enabled)
                case "$_val" in
                    0|1) ;;
                    *) printf '{"error":"value must be 0 or 1"}\n'; exit 1 ;;
                esac
                ;;
            imei_mode_slot1|imei_mode_slot2)
                case "$_val" in
                    random|deterministic|static) ;;
                    *) printf '{"error":"invalid IMEI mode"}\n'; exit 1 ;;
                esac
                ;;
            static_imei_slot1|static_imei_slot2)
                case "$_val" in
                    *[!0-9]*|'') printf '{"error":"IMEI must be 15 digits"}\n'; exit 1 ;;
                esac
                [ ${#_val} -eq 15 ] || { printf '{"error":"IMEI must be 15 digits"}\n'; exit 1; }
                ;;
            register_timeout)
                case "$_val" in
                    *[!0-9]*|'') printf '{"error":"timeout must be a number of seconds"}\n'; exit 1 ;;
                esac
                if [ "$_val" -lt 10 ] || [ "$_val" -gt 600 ]; then
                    printf '{"error":"timeout must be 10-600 seconds"}\n'; exit 1
                fi
                ;;
            rat_lock)
                case "$_val" in
                    0|1) ;;
                    *) printf '{"error":"value must be 0 or 1"}\n'; exit 1 ;;
                esac
                ;;
            default_region)
                case "$_val" in
                    EU|NA) ;;
                    *) printf '{"error":"region must be EU or NA"}\n'; exit 1 ;;
                esac
                ;;
            *)
                printf '{"error":"unknown option"}\n'
                exit 1
                ;;
        esac
        if [ "$_key" = "touch_enabled" ]; then
            if [ "$_val" = "1" ]; then
                /etc/init.d/norypt-ghost-touch enable 2>/dev/null
                /etc/init.d/norypt-ghost-touch start 2>/dev/null
            else
                /etc/init.d/norypt-ghost-touch stop 2>/dev/null
                /etc/init.d/norypt-ghost-touch disable 2>/dev/null
            fi
        fi
        # Persist every option (touch_enabled included, so postinst can
        # respect the preference across reinstalls/upgrades).
        uci -q get norypt-ghost.options >/dev/null 2>&1 \
            || uci -q set norypt-ghost.options=norypt-ghost
        uci -q set "norypt-ghost.options.${_key}=${_val}"
        uci -q commit norypt-ghost
        printf '{"saved":true}\n'
        ;;
    log)
        cat /tmp/norypt-ghost.log 2>/dev/null
        ;;
    *)
        printf '{"error":"unknown command"}\n'
        exit 1
        ;;
esac
